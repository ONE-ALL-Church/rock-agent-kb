{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rock-agent-kb",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://rock-agent-kb.oneandall.church",
    "GITHUB_OWNER": "ONE-ALL-Church",
    "GITHUB_REPO": "rock-agent-kb",
    "AUTO_MERGE_INTAKE": "false"
  },
  "d1_databases": [
    {
      "binding": "KB_DB",
      "database_name": "rock-agent-kb",
      "database_id": "72e145ba-3f65-4334-8d6f-72918ea92966"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KB_ARTIFACTS",
      "bucket_name": "rock-agent-kb-artifacts"
    }
  ],
  "ratelimits": [
    {
      "name": "ISSUE_REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "name": "rock-agent-kb",
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://rock-agent-kb.oneandall.church",
        "GITHUB_OWNER": "ONE-ALL-Church",
        "GITHUB_REPO": "rock-agent-kb",
        "AUTO_MERGE_INTAKE": "false"
      },
      "d1_databases": [
        {
          "binding": "KB_DB",
          "database_name": "rock-agent-kb",
          "database_id": "72e145ba-3f65-4334-8d6f-72918ea92966"
        }
      ],
      "r2_buckets": [
        {
          "binding": "KB_ARTIFACTS",
          "bucket_name": "rock-agent-kb-artifacts"
        }
      ],
      "ratelimits": [
        {
          "name": "ISSUE_REPORT_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 12,
            "period": 60
          }
        }
      ]
    }
  }
}
