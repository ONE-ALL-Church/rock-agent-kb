{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6919-affected-19.2.0", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "official", "claim_tier": "source_backed", "component": "rock_core", "confidence": "high", "context": {"scope": "Azure-backed BinaryFile storage under concurrent cache population"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6919", "https://github.com/SparkDevNetwork/Rock/issues/6919#issuecomment-4985819602", "https://github.com/SparkDevNetwork/Rock/blob/b4aee4df15d2aacf18d7c151e5601704ead7411b/Rock/Storage/Common/AzureBlobStorageClient.cs#L31-L80", "https://github.com/SparkDevNetwork/Rock/commit/d66a4f492306b10c7bd71aa13d54273918c941a3"], "fix_refs": ["https://github.com/SparkDevNetwork/Rock/commit/d66a4f492306b10c7bd71aa13d54273918c941a3"], "ranges": [], "release_track": "19.2", "status": "affected", "version_scheme": "rock_release", "versions": ["19.2.0"]}, {"assertion_id": "core-6919-fixed-by-commit-d66a4f4", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "high", "context": {"scope": "exact source revision; release package inclusion remains independently verifiable"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6919#issuecomment-4985819602", "https://github.com/SparkDevNetwork/Rock/commit/d66a4f492306b10c7bd71aa13d54273918c941a3", "https://github.com/SparkDevNetwork/Rock/blob/d66a4f492306b10c7bd71aa13d54273918c941a3/Rock/Storage/Common/AzureBlobStorageClient.cs#L38-L93", "https://github.com/SparkDevNetwork/Rock/blob/d66a4f492306b10c7bd71aa13d54273918c941a3/Rock.Tests/Storage/AzureBlobStorageClientRaceTests.cs#L30-L104"], "fix_refs": ["https://github.com/SparkDevNetwork/Rock/commit/d66a4f492306b10c7bd71aa13d54273918c941a3"], "ranges": [], "status": "fixed", "version_scheme": "git", "versions": ["d66a4f492306b10c7bd71aa13d54273918c941a3"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "high", "diagnosis_status": "maintainer_confirmed", "diagnosis_summary": "Public Rock 19.2 source used a shared mutable Dictionary cache in the singleton AzureBlobStorageClient and performed an unsynchronized ContainsKey/Add sequence. A Rock maintainer added a concurrent regression test, confirmed that it reproduced the reported race, replaced the cache with ConcurrentDictionary.GetOrAdd, and closed the issue. The issue is labeled Fixed in v19.4; verify exact package inclusion because a release-line label is not an exact build attestation.", "enrichment_id": "rock_issue_enrichment:core-6919-azure-container-cache-concurrency-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6919", "issue_updated_at": "2026-07-15T22:22:06Z", "license_attestation": true, "redaction_attestation": true, "review_status": "approved_for_public_distillation", "reviewed_at": "2026-07-16T00:00:06Z", "reviewer": "briand-delegated-codex-review", "schema": "rock-kb-rock-issue-enrichment-v1", "source_path": "issues/hosting-infrastructure/core-6919-azure-container-cache-concurrency.json", "source_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6919", "https://github.com/SparkDevNetwork/Rock/issues/6919#issuecomment-4985819602", "https://github.com/SparkDevNetwork/Rock/blob/b4aee4df15d2aacf18d7c151e5601704ead7411b/Rock/Storage/Common/AzureBlobStorageClient.cs#L31-L80", "https://github.com/SparkDevNetwork/Rock/blob/b4aee4df15d2aacf18d7c151e5601704ead7411b/Rock/Storage/Provider/AzureBlobStorage.cs#L131-L209", "https://github.com/SparkDevNetwork/Rock/commit/d66a4f492306b10c7bd71aa13d54273918c941a3", "https://github.com/SparkDevNetwork/Rock/blob/d66a4f492306b10c7bd71aa13d54273918c941a3/Rock/Storage/Common/AzureBlobStorageClient.cs#L38-L93", "https://github.com/SparkDevNetwork/Rock/blob/d66a4f492306b10c7bd71aa13d54273918c941a3/Rock.Tests/Storage/AzureBlobStorageClientRaceTests.cs#L30-L104"], "workaround_summaries": ["Use a Rock build proven to contain commit d66a4f492306b10c7bd71aa13d54273918c941a3. Until upgraded, an application-pool recycle may restore service after the reported failure, but it does not remove the concurrency defect and is not a durable fix."]}
{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6920-affected-develop-6e30556", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "high", "context": {"scope": "manual single-request workflows launched from Connections Hub that execute Redirect"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6920", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/Engagement/ConnectionsHub.cs#L5390-L5518", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Workflow/Action/WorkflowControl/Redirect.cs#L76-L159", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Workflow/Action/WorkflowControl/Redirect.cs#L161-L200"], "fix_refs": [], "ranges": [], "status": "affected", "version_scheme": "git", "versions": ["6e305568763043b3fb85c85142ce85b1ec566414"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "high", "diagnosis_status": "source_supported", "diagnosis_summary": "Current public Connections Hub source launches a single workflow by calling WorkflowService.Process and returns only an active Workflow Entry form URL. Redirect actions deliberately skip HttpContext redirects during any Obsidian block action request and expose their redirect through IInteractiveAction instead. Connections Hub does not invoke that interactive-action path or return its redirect message, which supports the reported missing browser navigation on the reviewed source revision.", "enrichment_id": "rock_issue_enrichment:core-6920-connections-hub-redirect-action-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6920", "issue_updated_at": "2026-07-15T14:37:09Z", "license_attestation": true, "redaction_attestation": true, "review_status": "approved_for_public_distillation", "reviewed_at": "2026-07-16T00:00:06Z", "reviewer": "briand-delegated-codex-review", "schema": "rock-kb-rock-issue-enrichment-v1", "source_path": "issues/connections/core-6920-connections-hub-redirect-action.json", "source_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6920", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/Engagement/ConnectionsHub.cs#L5390-L5518", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Workflow/Action/WorkflowControl/Redirect.cs#L76-L159", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Workflow/Action/WorkflowControl/Redirect.cs#L161-L200"], "workaround_summaries": ["Until Connections Hub handles interactive redirect results, do not rely on a Redirect action for a manually launched connection workflow. Use an active entry-form flow that Connections Hub can return, or launch the workflow from the classic Connection Request Board after staging verification."]}
