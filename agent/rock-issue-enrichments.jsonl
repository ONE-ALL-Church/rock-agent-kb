{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6897-affected-develop-6e30556", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "high", "context": {"scope": "completed workflows loaded through the Obsidian Workflow Entry block"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6897", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/WorkFlow/WorkflowEntry.cs#L355-L402", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/WorkFlow/WorkflowEntry.cs#L959-L994", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/Workflow/Workflow/Workflow.Logic.cs#L208-L256"], "fix_refs": [], "ranges": [], "status": "affected", "version_scheme": "git", "versions": ["6e305568763043b3fb85c85142ce85b1ec566414"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "high", "diagnosis_status": "source_supported", "diagnosis_summary": "Current public Rock source processes a loaded workflow during Workflow Entry block initialization. Workflow processing calls MarkComplete whenever no active activities remain, and MarkComplete unconditionally rewrites every activity completion time and the workflow CompletedDateTime before adding another completion log entry. This supports the reported timestamp mutation on the reviewed source revision; exact release-package boundaries remain unverified.", "enrichment_id": "rock_issue_enrichment:core-6897-workflow-entry-completion-timestamps-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6897", "issue_updated_at": "2026-06-27T20:25:10Z", "license_attestation": true, "redaction_attestation": true, "review_status": "approved_for_public_distillation", "reviewed_at": "2026-07-16T00:00:06Z", "reviewer": "briand-delegated-codex-review", "schema": "rock-kb-rock-issue-enrichment-v1", "source_path": "issues/workflows/core-6897-workflow-entry-completion-timestamps.json", "source_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6897", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/WorkFlow/WorkflowEntry.cs#L355-L402", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/WorkFlow/WorkflowEntry.cs#L959-L994", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/Workflow/Workflow/Workflow.Logic.cs#L208-L256"], "workaround_summaries": ["When an existing completion timestamp is an audit or reporting datum, do not open that completed workflow through Workflow Entry. Use a read-only report or detail surface that does not process the workflow, and verify the chosen surface in staging."]}
{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6904-affected-develop-6e30556", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "high", "context": {"scope": "LearningClassService.Copy with includeActivities enabled"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6904", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/LMS/LearningClass/LearningClassService.cs#L89-L139", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/LMS/LearningClassActivity/LearningClassActivityService.cs#L31-L57"], "fix_refs": [], "ranges": [], "status": "affected", "version_scheme": "git", "versions": ["6e305568763043b3fb85c85142ce85b1ec566414"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "high", "diagnosis_status": "source_supported", "diagnosis_summary": "Current public Rock source copies each LearningClassActivity when copying a class but does not clone its related LearningActivity, so the copied row retains the original content relationship. The same method also declares a newActivities list but never adds the copied activities before the attribute-save loop. By contrast, the single-activity copy path explicitly clones LearningActivity. This confirms both implementation differences on the reviewed source revision; exact affected release boundaries remain unverified.", "enrichment_id": "rock_issue_enrichment:core-6904-learning-class-copy-shares-activities-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6904", "issue_updated_at": "2026-07-02T17:02:38Z", "license_attestation": true, "redaction_attestation": true, "review_status": "approved_for_public_distillation", "reviewed_at": "2026-07-16T00:00:06Z", "reviewer": "briand-delegated-codex-review", "schema": "rock-kb-rock-issue-enrichment-v1", "source_path": "issues/learning-lms-engagement/core-6904-learning-class-copy-shares-activities.json", "source_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6904", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/LMS/LearningClass/LearningClassService.cs#L89-L139", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Model/LMS/LearningClassActivity/LearningClassActivityService.cs#L31-L57"], "workaround_summaries": ["Until the class-copy path is corrected, do not edit copied-class activity content under the assumption that it is independent. Build the new class and copy activities individually, then verify each copied LearningClassActivity points to a distinct LearningActivity before changing content."]}
{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6905-under-investigation-develop-6e30556", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "medium", "context": {"scope": "completed LMS classes with historical access enabled on narrow browser viewports"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6905", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/Lms/Public/PublicLearningClassWorkspace.cs#L475-L504", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.JavaScript.Obsidian.Blocks/src/Lms/publicLearningClassWorkspace.obs#L188-L256", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.JavaScript.Obsidian.Blocks/src/Lms/publicLearningClassWorkspace.obs#L500-L535"], "fix_refs": [], "ranges": [], "status": "under_investigation", "version_scheme": "git", "versions": ["6e305568763043b3fb85c85142ce85b1ec566414"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "medium", "diagnosis_status": "source_supported", "diagnosis_summary": "The public workspace block permits historical access server-side when the course allows it, but the reviewed client source chooses the completion screen before honoring an activity query parameter whenever every activity is complete. It clears the selected activity while showing the completion view; desktop retains a visible activity list, while the mobile presentation depends on the collapsed selector. This supports the reported navigation difference, but no public fix or exact package boundary is recorded.", "enrichment_id": "rock_issue_enrichment:core-6905-historical-lms-mobile-navigation-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6905", "issue_updated_at": "2026-07-02T19:37:32Z", "license_attestation": true, "redaction_attestation": true, "review_status": "approved_for_public_distillation", "reviewed_at": "2026-07-16T00:00:06Z", "reviewer": "briand-delegated-codex-review", "schema": "rock-kb-rock-issue-enrichment-v1", "source_path": "issues/learning-lms-engagement/core-6905-historical-lms-mobile-navigation.json", "source_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6905", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.Blocks/Lms/Public/PublicLearningClassWorkspace.cs#L475-L504", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.JavaScript.Obsidian.Blocks/src/Lms/publicLearningClassWorkspace.obs#L188-L256", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock.JavaScript.Obsidian.Blocks/src/Lms/publicLearningClassWorkspace.obs#L500-L535"], "workaround_summaries": ["For completed courses that must remain browsable, direct learners to the desktop workspace until the mobile selector behavior is fixed, and verify historical access with a completed test learner on every supported viewport."]}
{"agent_run_ids": [], "applicability": [{"assertion_id": "core-6912-under-investigation-18.3.5", "assessed_at": "2026-07-16T00:00:06Z", "authority_tier": "source-code-confirmed", "claim_tier": "source_backed", "component": "rock_core", "confidence": "medium", "context": {"scope": "in-memory bus using StartTaskQueue while a consumer is blocked"}, "evidence_refs": ["https://github.com/SparkDevNetwork/Rock/issues/6912", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Bus/Queue/RockQueue.cs#L70-L101", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Bus/Queue/StartTaskQueue.cs#L20-L32", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Bus/Consumer/RockConsumer.cs#L165-L184", "https://github.com/SparkDevNetwork/Rock/blob/6e305568763043b3fb85c85142ce85b1ec566414/Rock/Bus/Transport/Component/InMemory.cs#L55-L88"], "fix_refs": [], "ranges": [], "release_track": "18.3", "status": "under_investigation", "version_scheme": "rock_release", "versions": ["18.3.5"]}], "authority_tier": "community-reviewed", "claim_tier": "source_backed", "confidence": "medium", "diagnosis_status": "source_supported", "diagnosis_summary": "Current public Rock source gives queues a default 300-second time to live, leaves StartTaskQueue on that default, and registers every consumer for a queue on one receive endpoint. The in-memory transport adds no Rock-specific consume timeout or concurrency policy. This confirms a shared queue and expiration boundary, but source inspection alone does not prove that one blocked consumer stops all delivery or that every expired message is silent. The reported mechanism remains under investigation.", "enrichment_id": "rock_issue_enrichment:core-6912-start-task-queue-expiration-risk-v1", "issue_id": "rock_issue:SparkDevNetwork/Rock#6912", "issue_updated_at": "2026-07-12T18:49:38Z", "license_attestation": true, "redaction_attestation": true, 